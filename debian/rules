#!/usr/bin/make -f
# See debhelper(7) (uncomment to disable)
# output every command that modifies files on the build system.
#DH_VERBOSE=1

%:
	if status dmesg; then \
		dh $@; \
	else \
		dh $@ --with systemd; \
	fi

override_dh_builddeb:
# ref: https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=892664
	dh_builddeb -- -Zgzip
